# local Supabase from `make up` (supabase/config.toml); keys: `npx supabase status`
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

OPENROUTER_API_KEY=
# chat agent model on OpenRouter (default anthropic/claude-haiku-5.5)
CINESENSE_LLM_MODEL=

# chat turns per visitor per minute / per day, and for the whole site per day (defaults 6 / 25 / 800)
CHAT_LIMIT_PER_MINUTE=
CHAT_LIMIT_PER_DAY=
CHAT_LIMIT_SITE_PER_DAY=
# turns per visitor per day on the technical view /admin/tech (own counter, default 50)
TECH_LIMIT_PER_DAY=

# login for the admin area (/admin pages, /api/inspect, /api/admin/*, /api/eval/*); unset: open (local development only)
TECH_USER=
TECH_PASSWORD=
# folder with the saved `make eval` runs for /admin/evaluation (default: evaluation/results in the repo)
CINESENSE_EVAL_DIR=
# writable folder for runs started on /admin/evaluation (default: CINESENSE_EVAL_DIR)
CINESENSE_EVAL_RUNS_DIR=

# LangSmith tracing (EU account)
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cinesense
LANGSMITH_ENDPOINT=

# TMDB is not used (its terms forbid AI applications)

STREAMING_AVAILABILITY_API_KEY=
YOUTUBE_API_KEY=
# local path to movieFinder's MovieLens SQLite (not committed; research licence)
MOVIELENS_DB_PATH=

NEXT_PUBLIC_API_URL=http://localhost:8000
